{
  "permissions": {
    "allow": [
      "Bash(make next)",
      "Bash(make check)",
      "Bash(make backlog)",
      "Bash(make agents)",
      "Bash(make test-tools)",
      "Bash(python3 tools/next_step.py:*)",
      "Bash(python3 tools/context.py:*)",
      "Bash(python3 tools/gen_backlog.py:*)",
      "Bash(python3 tools/check_workflow.py)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(terraform apply:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(make approve:*)",
      "Bash(python3 tools/approve.py:*)",
      "Bash(cat .env:*)",
      "Bash(sudo:*)",
      "Bash(mkfs:*)",
      "Bash(shred:*)",
      "Bash(diskutil eraseDisk:*)",
      "Bash(diskutil eraseVolume:*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/gate_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/context_watch.py\""
          }
        ]
      }
    ]
  }
}
